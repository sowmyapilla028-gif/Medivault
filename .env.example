# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public URL of this server. OAuth redirect URIs are derived from it:
#   ${APP_URL}/auth/epic/callback  (EHR)   and   ${APP_URL}/auth/cms/callback  (CMS)
APP_URL=http://localhost:3000
# Any long random string
SESSION_SECRET=

# ---------------- AI model ----------------
# Default: any OpenAI-compatible Chat Completions API. OpenCode Zen shown here.
LLM_PROVIDER=openai
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
# A model ID from your provider that uses /chat/completions (list them: see README)
LLM_MODEL=
# true only if LLM_MODEL accepts images (needed for photo uploads)
LLM_VISION=false

# To use Claude instead: LLM_PROVIDER=anthropic and set ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=

# ---------------- EHR (SMART on FHIR R4) ----------------
# Leave everything below empty to use the free SMART Health IT sandbox
# (https://launch.smarthealthit.org): no registration, synthetic patients, any client ID works.
# EHR_FHIR_BASE=https://launch.smarthealthit.org/v/r4/fhir
# EHR_CLIENT_ID=medivault-demo
# EHR_LABEL=SMART Health IT
#
# For Epic later: set EPIC_CLIENT_ID (and remove EHR_FHIR_BASE) to use fhir.epic.com.
# EPIC_CLIENT_ID=

# ---------------- CMS Blue Button 2.0 (sandbox.bluebutton.cms.gov) ----------------
CMS_CLIENT_ID=
CMS_CLIENT_SECRET=
