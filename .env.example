# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public URL of this server. The OAuth redirect URIs are derived from it:
#   ${APP_URL}/auth/epic/callback   and   ${APP_URL}/auth/cms/callback
# Register exactly these URLs with Epic and CMS.
APP_URL=http://localhost:3000
# Any long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# --- Claude (reads uploaded documents and writes recommendations) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Epic (fhir.epic.com sandbox) ---
# Use the Non-Production Client ID of your app. Leave the secret empty for a public client (PKCE).
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
# EPIC_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# EPIC_SCOPES=openid fhirUser launch/patient patient/Patient.read patient/Condition.read patient/Observation.read patient/AllergyIntolerance.read patient/Immunization.read

# --- CMS Blue Button 2.0 (sandbox.bluebutton.cms.gov) ---
CMS_CLIENT_ID=
CMS_CLIENT_SECRET=
# CMS_FHIR_BASE=https://sandbox.bluebutton.cms.gov/v2/fhir
# CMS_SCOPES=openid profile patient/Patient.read patient/ExplanationOfBenefit.read
